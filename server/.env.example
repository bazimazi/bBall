# bBall server configuration.
#
# Copy to `.env` for local development, or set these as real environment
# variables in production. Nothing in this file is a working secret - the
# server refuses to start in production without a real AUTH_SECRET, and
# generates a throwaway one in development so a fresh clone runs immediately.

NODE_ENV=development
HOST=127.0.0.1
PORT=8787

# --- database ---------------------------------------------------------------
# SQLite file. Use an absolute path in production and put it on a volume that
# is actually backed up; ':memory:' is rejected outside development.
DATABASE_FILE=./data/bball.db
DATABASE_BUSY_TIMEOUT_MS=5000

# --- authentication ---------------------------------------------------------
# Signing key for access tokens. Required in production, minimum 32 chars.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# AUTH_SECRET=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
EMAIL_TOKEN_TTL_SECONDS=86400

# Close registration without a redeploy.
REGISTRATION_OPEN=true
# Require a confirmed email address before progression can be written.
REQUIRE_VERIFIED_EMAIL=false

# --- http -------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API with credentials.
# Empty means same-origin only. Never use '*' here: it is incompatible with
# credentialed requests and would disable the protection entirely.
CORS_ORIGINS=http://localhost:5173

# Set when the API and the game are on different hosts under one domain.
# COOKIE_DOMAIN=.example.com
COOKIE_SAMESITE=lax

# Used to build the links in verification and password-reset emails.
PUBLIC_APP_URL=http://localhost:5173

# Turn on only when the process really is behind a proxy that sets
# X-Forwarded-For. On without a proxy, any client can forge its own address
# and escape rate limiting.
TRUST_PROXY=false
BODY_LIMIT_BYTES=262144

# --- rate limiting ----------------------------------------------------------
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=240
AUTH_RATE_LIMIT_MAX=20

# --- social sign-in ---------------------------------------------------------
# Each provider appears in the game only when it is completely configured, so
# leaving a block commented out simply means no button for it.
#
# Providers redirect back to this origin, which is the API rather than the
# game. Defaults to PUBLIC_APP_URL, which is right when the two are served
# together. The callback to register with each provider is:
#   <OAUTH_REDIRECT_BASE>/v1/auth/oauth/<provider>/callback
# OAUTH_REDIRECT_BASE=http://localhost:5173

# Google: console.cloud.google.com -> Credentials -> OAuth client ID (Web).
# Add the callback above as an authorised redirect URI.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Apple: developer.apple.com -> Identifiers -> Services ID for APPLE_CLIENT_ID,
# and Keys -> "Sign in with Apple" for the key id and the .p8 file. The team id
# is on the membership page. Newlines in the key may be written as \n.
# APPLE_CLIENT_ID=com.example.bball.web
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=

# --- logging and mail -------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
# LOG_LEVEL=info

# log   - print the message (development)
# noop  - drop it
# memory- keep it in memory (tests)
# Production should wire a real provider; see services/mail.ts.
MAIL_DRIVER=log
MAIL_FROM=bBall <no-reply@bball.local>
