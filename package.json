{
  "name": "bball",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A fast, minimal bouncing-ball duel built with Vite, React and TypeScript.",
  "license": "MIT",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "vite",
    "start": "vite --open",
    "build": "tsc --build && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --build --force",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,css,html,json,md}\"",
    "server": "npm run dev --workspace server",
    "server:build": "npm run build --workspace server",
    "server:start": "npm run start --workspace server",
    "server:test": "npm run test --workspace server",
    "server:migrate": "npm run migrate --workspace server",
    "test": "npm run test --workspace server"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true
  }
}
